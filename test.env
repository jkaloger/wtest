MOCK_PORT=4010

# Literal loopback IP, never DNS. Server-side and browser-side both hit the mock server.
SUPABASE_URL=http://127.0.0.1:4010
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:4010

# Unsigned placeholder: nothing verifies it, the mock server answers every auth call.
SUPABASE_ANON_KEY=test-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key
